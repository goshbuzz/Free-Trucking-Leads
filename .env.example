# FMCSA QCMobile webKey — required for carrier registration / phone / email lookups.
# Free: sign in at https://mobile.fmcsa.dot.gov with Login.gov -> My WebKeys.
# The app also accepts FMCSA_WEBKEY, FMCSA_API_KEY, FMCSA_KEY, QCMOBILE_WEB_KEY or WEBKEY.
FMCSA_WEB_KEY=

# Optional: Socrata app token for data.transportation.gov (raises the rate limit).
# The census and Motus insurance datasets are public and work without it.
# SOCRATA_APP_TOKEN=

# Optional limits & request-rate pacing (defaults shown)
# MAX_ROWS_PER_FILE=5000
# MAX_FILE_BYTES=2097152
# ENRICH_CONCURRENCY=3
# UPSTREAM_MIN_INTERVAL_MS=120
# UPSTREAM_403_COOLDOWN_MS=1500

# Optional: 1 generates local demo records instead of calling FMCSA. Never set in production.
# Also makes Preview Leads return demo carriers instead of live census rows.
# MOCK_FMCSA=0

# Optional: turn the public FMCSA open-data lookups off (0/false).
# MOTUS_ENABLED=1

# Optional: set the public canonical site URL and Google Search Console verification token.
# NEXT_PUBLIC_SITE_URL=https://freetruckingleads.goshbuzz.com
# GOOGLE_SITE_VERIFICATION=
